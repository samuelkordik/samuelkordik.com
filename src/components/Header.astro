---
import { site } from '../data/site';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const path = Astro.url.pathname;
---
<header class:list={['site-header', { overlay }]}>
  <div class="wrap">
    <a class="name" href="/">{site.name}</a>
    <nav aria-label="Main" id="site-nav">
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav-list">Menu</button>
      <ul id="site-nav-list">
        {site.nav.map((item) => (
          <li><a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li><a class="btn" href="/contact/">Work with me</a></li>
      </ul>
    </nav>
  </div>
</header>
<script>
  const nav = document.getElementById('site-nav');
  const btn = nav?.querySelector('button');
  btn?.addEventListener('click', () => {
    const open = nav!.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
