---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';

export async function getStaticPaths() {
  const guides = await getCollection('guides', (e) => !e.data.draft);
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}
const { guide } = Astro.props;
const { Content, headings } = await render(guide);
const d = guide.data;
---
<Article title={d.title} description={d.description} eyebrow="Guide" lede={d.description} pubDate={d.pubDate} updatedDate={d.updatedDate} headings={headings} image={d.cover}>
  <Content />
  <p slot="after" class="back"><a class="link" href="/teaching/">Teaching &amp; guides</a></p>
</Article>
<style>.back { margin-top: 56px; }</style>
