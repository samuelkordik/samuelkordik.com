---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const guides = (await getCollection('guides', (e) => !e.data.draft)).sort((a, b) => a.data.title.localeCompare(b.data.title));
const courses = (await getCollection('courses', (e) => !e.data.draft)).sort((a, b) => +b.data.updatedDate - +a.data.updatedDate);
---
<Base title="Teaching" description="Guides, course materials, and downloads from Samuel Kordik's EMS teaching.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">Teaching</p>
      <h1>Teaching since 2001</h1>
      <p class="lede">From skills labs and CE classes to EMT and paramedic programs, and from 2017 as a paramedic program director and advanced course coordinator. Here are guides and course materials, free to use.</p>
    </header>

    <section class="block">
      <h2>Guides</h2>
      <ul class="cards">
        {guides.map((g) => <li><a href={`/guides/${g.id}/`}><h3>{g.data.title}</h3><p>{g.data.description}</p></a></li>)}
      </ul>
    </section>

    <section class="block">
      <h2>Course materials</h2>
      {courses.length ? (
        <ul class="cards">
          {courses.map((c) => <li><a href={`/teaching/${c.id}/`}><h3>{c.data.title}</h3><p>{c.data.summary}</p></a></li>)}
        </ul>
      ) : (
        <p class="empty">Materials for the courses I’m teaching will be posted here.</p>
      )}
    </section>

  </div>
</Base>
<style>
  .block { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 40px; border-top: 1px solid var(--rule); padding-block: 32px 48px; }
  .block h2 { font-size: var(--h3); }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .cards a { display: block; height: 100%; background: var(--surface); border: 1px solid var(--rule); border-radius: 8px; padding: 22px 24px; transition: border-color 0.15s; }
  .cards a:hover { border-color: var(--accent); }
  .cards h3 { font-size: 1.375rem; margin-bottom: 6px; }
  .cards p { color: var(--muted); font-size: 0.96875rem; }
  .empty { color: var(--muted); }
  @media (max-width: 800px) { .block, .cards { grid-template-columns: minmax(0, 1fr); gap: 16px; } }
</style>
